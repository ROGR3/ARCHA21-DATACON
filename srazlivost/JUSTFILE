set dotenv-load := false

rust_dir := "matching_rust"
common_args := "--company cpzp --num-runs 100 --data-dir data --out-dir out --specialty-analysis"

# list available recipes
default:
    @just --list

# reshape raw OZP + CPZP dumps (B01 srážlivost + N02BF/N06AA neuropatie) into
# unified preskladane CSVs under data/
reshape:
    python reshape_new_data.py --out-dir data

# reshape only OZP
reshape-ozp:
    python reshape_new_data.py --company ozp --out-dir data

# reshape only CPZP
reshape-cpzp:
    python reshape_new_data.py --company cpzp --out-dir data

# krok 1: měsíční křivky předpisů B01AA/AB/AE/AF/AX + celkem, po věku,
# po očko/neočko a po specializaci (cpzp, ozp, both_companies)
# výstupy: charts/<company>/*.png
charts:
    python generate_charts.py

# build the Rust matching binary (release)
build:
    cargo build --release --manifest-path {{rust_dir}}/Cargo.toml

# run all 15 simulations (5 offsets × 3 analysis modes)
simulate: build
    #!/usr/bin/env bash
    set -e
    for flag in "" "--inj-analysis" "--every-prescription"; do
        for offset in 3 2 1 0 -1; do
            echo "========================================"
            echo "Running: year-offset=$offset ${flag:-"(no extra flag)"}"
            echo "========================================"
            cargo run --release --manifest-path {{rust_dir}}/Cargo.toml -- {{common_args}} --year-offset "$offset" $flag
            echo ""
        done
    done
    echo "All simulations done."

# SCCS analýza předpisů B01 kolem očkování (port kortikoidy/max_vax_analysis)
# + virtuální očkování o 1–4 roky dřív, varianta bez 28 dní před očkováním (HVE)
# a normalizace na celou populaci stejného věku
# výstupy: charts/<company>/sccs/, popis v charts/README.md
sccs:
    #!/usr/bin/env bash
    set -e
    for company in cpzp ozp both_companies; do
        python sccs_analysis.py --company "$company" --year-offsets 0 1 2 3 4 --hve-days 0 28
        python sccs_souhrn.py --company "$company" --hve-days 0 28
    done
